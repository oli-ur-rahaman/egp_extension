{
  "manifest_version": 3,
  "name": "PDMS eGP Extractor",
  "short_name": "eGP Extractor",
  "version": "0.8.0",
  "description": "Collects report data from the e-GP portal into Excel, inside your own logged-in session.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "scripting", "tabs", "downloads", "notifications", "alarms"],
  "host_permissions": ["*://*.eprocure.gov.bd/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel/index.html"
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Open eGP Extractor",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
