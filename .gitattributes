# Same bytes on both PCs: LF in the repo and in the working tree.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.docx binary
*.xlsx binary
*.png binary
*.jpg binary
*.zip binary
# Vendored files are hash-checked (vendor/SHA256SUMS); git must never touch their bytes.
vendor/** -text
